{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://learn-english.local/schemas/dialogue.schema.json",
  "title": "DialogueArtifact",
  "description": "Generated dialogue for one clinical context and CEFR package (US-G1-041/042).",
  "type": "object",
  "additionalProperties": false,
  "required": ["context", "cefr_level", "lines"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Optional dialogue artifact id."
    },
    "context": {
      "type": "string",
      "enum": ["patient_family", "colleague_sbar", "expert_cme"],
      "description": "MVP bối cảnh: patient/family, colleague+SBAR, or expert/CME."
    },
    "cefr_level": {
      "type": "string",
      "enum": ["A2", "B1", "C1"],
      "description": "One of the three CEFR learning packages."
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/dialogueLine"
      }
    }
  },
  "definitions": {
    "dialogueLine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["speaker", "text", "fact_ids"],
      "properties": {
        "speaker": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "description": "English dialogue line (primary language)."
        },
        "text_vi": {
          "type": "string",
          "minLength": 1,
          "description": "Optional Vietnamese gloss; never replaces English audio."
        },
        "fact_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Non-empty links to verified clinical fact card ids."
        },
        "is_key_phrase": {
          "type": "boolean",
          "description": "When true, line is a candidate for shadowing cards."
        }
      }
    }
  }
}
