# Copy to backend/.env and fill with a Google Cloud OAuth 2.0 Web client.
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

# Long random secrets (do not commit real values)
JWT_SECRET=
SESSION_SECRET=

# SPA origin allowed for credentialed CORS
FRONTEND_ORIGIN=http://127.0.0.1:5173
API_PUBLIC_BASE_URL=http://127.0.0.1:8000

COOKIE_NAME=le_session
COOKIE_SECURE=false
COOKIE_MAX_AGE=86400
COOKIE_SAMESITE=lax

# SQLite path (MVP stand-in for Cloud SQL)
DATABASE_PATH=./data/learn_english.sqlite3

# Comma-separated emails promoted to admin on first Google login
BOOTSTRAP_ADMIN_EMAILS=you@example.com

# Object storage: local filesystem by default. Set GCS_BUCKET to use GCS.
STORAGE_ROOT=./data/objects
# GCS_BUCKET=your-bucket-name
# GCS_LOCATION=asia-southeast1
# Optional: uv add google-cloud-storage when enabling GCS

PDF_MAX_BYTES=26214400
SIGNED_URL_TTL_SECONDS=300

# Optional demo TTS (default synthetic silent WAV for CI)
# USE_EDGE_TTS=true

# Pha 2 pronunciation assessment (default synthetic scorer for CI)
# USE_AZURE_PA=true
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=eastasia
# PA_DAILY_LIMIT=50
# PA_COST_PER_SCORE_USD=0.01
# USE_GEMINI_EMPATHY=true
