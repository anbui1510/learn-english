# Copy to backend/.env and fill with a Google Cloud OAuth 2.0 Web client.
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

# Long random secrets (do not commit real values)
JWT_SECRET=
SESSION_SECRET=

# SPA origin allowed for credentialed CORS
FRONTEND_ORIGIN=http://127.0.0.1:5173

COOKIE_NAME=le_session
COOKIE_SECURE=false
COOKIE_MAX_AGE=86400
COOKIE_SAMESITE=lax
